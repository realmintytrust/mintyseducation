# Set the port on which Doge V5 will run on.
# PORT=2345

# Choose whether or not to use the Bare Server.
# Set to true or leave it alone if using Vercel.
# BARE="false"

# Choose whether or not you want to enable MASQR.
# Separate licensing server required for this to work.
# https://github.com/titaniumnetwork-dev/MasqrProject
# MASQR="false"

# Enable static hosting mode for things like Github Pages.
# STATIC="true"

# Require HTTP Basic authentication for every request.
# Uncomment both lines and set values to enable.
# BASIC_AUTH_USER="admin"
# BASIC_AUTH_PASS="change-me"

# Fake login screen credentials (front-end gate).
# VITE_FAKE_LOGIN_USER="MintyAdmin173"
# VITE_FAKE_LOGIN_PASS="schooleducation123"
